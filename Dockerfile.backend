# filepath: Dockerfile.backend
FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY backend/package*.json ./

# Install dependencies
RUN npm ci --only=production

# Copy backend source
COPY backend/ .

# Expose port
EXPOSE 3001

# Environment variables
ENV PORT=3001
ENV FRONTEND_URL=http://localhost:3000

# Start the server
CMD ["node", "server.js"]