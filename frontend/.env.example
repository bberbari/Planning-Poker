# Copy to .env for local dev. For Cloudflare Pages / Netlify / Vercel, set these in the host UI (not in git).
# Use your Render backend URL (https://your-service.onrender.com) — no trailing slash.

VITE_API_URL=http://localhost:3001
# Optional; defaults to VITE_API_URL if unset (so production often needs only VITE_API_URL).
# VITE_SOCKET_URL=http://localhost:3001
